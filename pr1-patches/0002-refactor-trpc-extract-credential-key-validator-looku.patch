Subject: [PATCH 2/3] refactor(trpc): extract credential key validator lookup

Move the map of server-side validators out of updateAppCredentials into
credentialKeyValidators.ts, behind getCredentialKeyValidatorLoader. This
is where the fix registers the schemas of the other apps. Behavior is
unchanged: the characterization tests pass without any edit.

Refs #30566
---
 .../viewer/apps/credentialKeyValidators.ts    | 19 +++++++++++++++++++
 .../apps/updateAppCredentials.handler.ts      | 13 ++++---------
 2 files changed, 23 insertions(+), 9 deletions(-)
 create mode 100644 packages/trpc/server/routers/viewer/apps/credentialKeyValidators.ts

diff --git a/packages/trpc/server/routers/viewer/apps/credentialKeyValidators.ts b/packages/trpc/server/routers/viewer/apps/credentialKeyValidators.ts
new file mode 100644
index 0000000..87242f5
--- /dev/null
+++ b/packages/trpc/server/routers/viewer/apps/credentialKeyValidators.ts
@@ -0,0 +1,19 @@
+import type { TUpdateAppCredentialsInputSchema } from "./updateAppCredentials.schema";
+
+type CredentialKeyValidatorLoader = () => Promise<CredentialKeyValidator>;
+
+// Loaded on demand so that an app's code is only imported when its credential is updated.
+const validatorLoaders: Map<string, CredentialKeyValidatorLoader> = new Map([
+  [
+    "paypal",
+    async (): Promise<CredentialKeyValidator> =>
+      (await import("@calcom/paypal/lib/updateAppCredentials.validator")).default,
+  ],
+]);
+
+/** Validates the key sent to viewer.apps.updateAppCredentials and returns what should be stored. */
+export type CredentialKeyValidator = (args: { input: TUpdateAppCredentialsInputSchema }) => Promise<unknown>;
+
+/** Returns the loader of the server-side validator registered for `appId`, if any. */
+export const getCredentialKeyValidatorLoader = (appId: string): CredentialKeyValidatorLoader | undefined =>
+  validatorLoaders.get(appId);
diff --git a/packages/trpc/server/routers/viewer/apps/updateAppCredentials.handler.ts b/packages/trpc/server/routers/viewer/apps/updateAppCredentials.handler.ts
