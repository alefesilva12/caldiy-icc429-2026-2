Date: Tue, 24 Nov 2026 21:42:38 -0400
Subject: [PATCH 3/3] refactor(trpc): select only needed credential fields

Read only id, appId and key from Credential, and return only the id from
the update, instead of whole rows. The handler already used only these
fields and still returns a boolean, so callers see no difference; the
characterization tests pass without any edit.

Refs #30566
---
 .../server/routers/viewer/apps/updateAppCredentials.handler.ts  | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/packages/trpc/server/routers/viewer/apps/updateAppCredentials.handler.ts b/packages/trpc/server/routers/viewer/apps/updateAppCredentials.handler.ts
index 48d6c03..290f76c 100644
--- a/packages/trpc/server/routers/viewer/apps/updateAppCredentials.handler.ts
+++ b/packages/trpc/server/routers/viewer/apps/updateAppCredentials.handler.ts
@@ -40,6 +40,7 @@ export const updateAppCredentialsHandler = async ({ ctx, input }: UpdateAppCrede
       id: input.credentialId,
       userId: user.id,
     },
+    select: { id: true, appId: true, key: true },
   });
   // Check if credential exists
   if (!credential) {
@@ -61,6 +62,7 @@ export const updateAppCredentialsHandler = async ({ ctx, input }: UpdateAppCrede
         ...(validatedKeys as Prisma.JsonObject),
       },
     },
+    select: { id: true },
   });
 
   return !!updated;
